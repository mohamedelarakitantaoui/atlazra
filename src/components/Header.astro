---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t, getRedesign } from '../i18n/content';
import type { Locale } from '../i18n/routing';
interface Props {
  locale: Locale;
  languagePath?: string;
}
const { locale, languagePath } = Astro.props;
const r = getRedesign(locale);
const current = (section: string) =>
  Astro.url.pathname.startsWith(`/${locale}/${section}/`) ? 'page' : undefined;
---

<header class="site-header">
  <div class="wrap bar">
    <a
      class="brand"
      href={`/${locale}/`}
      aria-label={`${t(locale,'footer.brand')} — ${t(locale, 'nav.home')}`}
      dir="ltr"
      ><img src="/redesign/monogram.webp" alt="" width="30" height="26" /><span
        >ATLAZRA</span
      ></a
    >
    <nav
      class="main-nav"
      id="main-nav"
      data-open="false"
      aria-label={t(locale, 'nav.label')}
    >
      <ul>
        <li><a href={`/${locale}/#plan`}>{r.n1}</a></li>
        <li>
          <a href={`/${locale}/services/`} aria-current={current('services')}
            >{r.n2}</a>
        </li>
        <li><a href={`/${locale}/#palette`}>{r.n3}</a></li>
        <li><a href={`/${locale}/#etapes`}>{r.n4}</a></li>
        <li>
          <a
            href={`/${locale}/realisations/`}
            aria-current={current('realisations')}
            >{t(locale, 'nav.projects')}</a>
        </li>
        <li>
          <a href={`/${locale}/contact/`} aria-current={current('contact')}
            >{r.n5}</a>
        </li>
      </ul>
    </nav>
    <LanguageSwitcher {locale} path={languagePath} />
    <a class="btn btn-gold header-cta" href={`/${locale}/contact/`}>{r.cta}</a>
    <button
      class="menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="main-nav"
      aria-label={t(locale, 'nav.menu')}
      ><span aria-hidden="true"></span></button
    >
  </div>
</header>
<script>
  const nav = document.querySelector<HTMLElement>('.main-nav');
  const button = document.querySelector<HTMLButtonElement>('.menu-btn');
  if (nav && button) {
    const setMenu = (open: boolean) => {
      nav.dataset.open = String(open);
      button.setAttribute('aria-expanded', String(open));
    };
    button.addEventListener('click', () =>
      setMenu(nav.dataset.open !== 'true'),
    );
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setMenu(false);
    });
    addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.dataset.open === 'true') {
        setMenu(false);
        button.focus();
      }
    });
  }
</script>
<style>
  .site-header {
    position: relative;
    z-index: 20;
    background: var(--paper);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 84px;
  }
  .brand {
    direction: ltr;
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    min-height: 44px;
    flex: none;
  }
  .main-nav {
    margin-inline-start: auto;
  }
  .brand img {
    width: 30px;
    height: auto;
  }
  .brand span {
    font: 800 22px/1 var(--display);
    letter-spacing: 0.32em;
    color: var(--ink-900);
  }
  ul {
    display: flex;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .main-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    min-inline-size: 44px;
    font-size: 14px;
    text-decoration: none;
    color: var(--ink-2);
  }
  .main-nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  .header-cta {
    font-size: 14px;
    padding-inline: 20px;
    white-space: nowrap;
  }
  .menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--paper);
    cursor: pointer;
    place-items: center;
    color: var(--ink);
  }
  .menu-btn span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    box-shadow:
      0 5px 0 currentColor,
      0 -5px 0 currentColor;
  }
  @media (max-width: 1200px) {
    .main-nav {
      position: absolute;
      top: 100%;
      inset-inline: var(--pad);
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: 20px;
      padding: 8px 20px;
      box-shadow: 0 20px 40px -20px rgba(15, 36, 25, 0.3);
    }
    .main-nav[data-open='false'] {
      display: none;
    }
    ul {
      flex-direction: column;
      gap: 0;
    }
    .main-nav a {
      display: flex;
      padding: 14px 0;
      font-size: 17px;
      border-bottom: 1px solid var(--line);
    }
    .menu-btn {
      display: grid;
    }
    .bar :global(.lang) {
      margin-inline-start: auto;
    }
  }
  @media (max-width: 860px) {
    .header-cta {
      display: none;
    }
    .bar {
      min-height: 80px;
      gap: 8px;
    }
    .brand {
      gap: 8px;
    }
    .brand img {
      width: 24px;
    }
    .brand span {
      font-size: 20px;
      letter-spacing: 0.16em;
    }
  }
</style>
