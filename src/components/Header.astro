---
import Logo from './ui/Logo.astro';
import Button from './ui/Button.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { content } from '../i18n/content';
import type { Locale } from '../i18n/routing';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = content[locale];
---

<header>
  <div class="wrap bar">
    <a class="brand" href={`/${locale}/`} aria-label={t.top}
      ><Logo decorative /></a
    >
    <nav
      class="main-nav"
      id="main-nav"
      data-open="false"
      aria-label={t.navigation}
    >
      <ul>
        <li><a href={`/${locale}/#services`}>{t.services}</a></li>
        <li><a href={`/${locale}/#etapes`}>{t.process}</a></li>
        <li><a href={`/${locale}/#projets`}>{t.projects}</a></li>
        <li><a href={`/${locale}/contact/`}>{t.contact}</a></li>
      </ul>
    </nav>
    <LanguageSwitcher {locale} />
    <Button class="header-cta" href={`/${locale}/contact/`}>{t.cta}</Button>
    <button
      class="menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="main-nav"
      aria-label={t.menu}><span></span></button
    >
  </div>
</header>

<script>
  const header = document.querySelector('header');
  const nav = document.querySelector<HTMLElement>('.main-nav');
  const button = document.querySelector<HTMLButtonElement>('.menu-btn');
  if (header && nav && button) {
    const setMenu = (open: boolean) => {
      nav.dataset.open = String(open);
      button.setAttribute('aria-expanded', String(open));
    };
    button.addEventListener('click', () =>
      setMenu(nav.dataset.open !== 'true'),
    );
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setMenu(false);
    });
    addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.dataset.open === 'true') {
        setMenu(false);
        button.focus();
      }
    });
    const scroll = () => header.classList.toggle('scrolled', scrollY > 8);
    addEventListener('scroll', scroll, { passive: true });
    scroll();
  }
</script>

<style>
  /* Reference header and navigation, lines 52–74. */
  header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: var(--glass-header);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    transition: box-shadow var(--dur) ease;
  }
  header.scrolled {
    box-shadow: 0 1px 0 var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 60px;
  }
  .brand {
    display: flex;
    align-items: center;
    color: var(--forest);
    text-decoration: none;
    margin-inline-end: auto;
    min-height: 44px;
  }
  ul {
    display: flex;
    gap: 26px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .main-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  .main-nav a:hover {
    color: var(--ink);
  }
  .bar :global(.header-cta) {
    min-height: 44px;
    padding: 0 16px;
    font-size: 0.88rem;
  }
  .menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: var(--radius-pill);
    border: 0;
    background: var(--mist);
    cursor: pointer;
    place-items: center;
  }
  .menu-btn span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--ink);
    box-shadow:
      0 5px 0 var(--ink),
      0 -5px 0 var(--ink);
  }
  @media (prefers-reduced-transparency: reduce) {
    header {
      background: var(--paper);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
  @media (max-width: 860px) {
    .main-nav {
      position: absolute;
      inset: 100% 0 auto;
      background: var(--paper);
      box-shadow: 0 12px 24px rgba(23, 32, 27, 0.08);
      transform-origin: top;
      transition:
        opacity var(--dur) var(--ease-out),
        transform var(--dur) var(--ease-out);
    }
    .main-nav[data-open='false'] {
      opacity: 0;
      transform: translateY(-6px);
      pointer-events: none;
      visibility: hidden;
    }
    ul {
      flex-direction: column;
      gap: 0;
      padding: 6px max(20px, env(safe-area-inset-right, 0px)) 14px
        max(20px, env(safe-area-inset-left, 0px));
    }
    .main-nav a {
      display: block;
      padding: 14px 0;
      font-size: 1.05rem;
      color: var(--ink);
      border-bottom: 1px solid var(--rule);
    }
    .menu-btn {
      display: grid;
    }
    .bar :global(.header-cta) {
      display: none;
    }
  }
  /* Keep the required 44px language/menu targets within a 360px screen. */
  @media (max-width: 380px) {
    .bar {
      gap: var(--space-1);
    }
  }
</style>
