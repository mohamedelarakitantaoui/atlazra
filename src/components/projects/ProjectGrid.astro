---
import type { Project } from '../../lib/projects';
import { coverAlt } from '../../lib/projects';
import type { Locale } from '../../i18n/routing';
import { t } from '../../i18n/content';
import ProjectImage from './ProjectImage.astro';
interface Props {
  projects: Project[];
  locale: Locale;
  eager?: boolean;
  /** h3 when the grid sits under a section h2 (home teaser). */
  headingLevel?: 2 | 3;
}
const { projects, locale, eager = false, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
// The first card spans the row only when the rest pair up evenly.
const featured = projects.length % 2 === 1;
---

<div class:list={['project-grid', { featured }]}>
  {
    projects.map((project, index) => (
      <article data-project-type={project.data.type}>
        <a href={`/${locale}/realisations/${project.id}/`}>
          <ProjectImage
            src={project.data.cover}
            alt={coverAlt(project, locale)}
            eager={eager && index === 0}
            sizes={
              featured && index === 0
                ? '(max-width: 1160px) calc(100vw - 40px), 1120px'
                : '(max-width: 700px) calc(100vw - 40px), 544px'
            }
          />
          <div class="project-caption">
            <>
              <Heading class="title">{project.data.title[locale]}</Heading>
              <p>
                {project.data.city} ·{' '}
                {t(locale, `projects.types.${project.data.type}`)}
              </p>
            </>
          </div>
        </a>
      </article>
    ))
  }
</div>
<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px 32px;
  }
  .featured article:first-child {
    grid-column: 1 / -1;
  }
  /* Offset the second column for a quieter, staggered rhythm. */
  .featured article:nth-child(2n + 3),
  .project-grid:not(.featured) article:nth-child(2n) {
    padding-block-start: 80px;
  }
  a {
    display: block;
    text-decoration: none;
  }
  article :global(img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-m);
    background: var(--mist);
  }
  .featured article:first-child :global(img) {
    aspect-ratio: 2 / 1;
  }
  .project-caption {
    padding-block-start: 20px;
    display: grid;
    gap: 8px;
  }
  .title {
    font-size: clamp(1.35rem, 2.5vw, 2rem);
  }
  p {
    color: var(--ink-2);
  }
  @media (max-width: 700px) {
    .project-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .featured article:nth-child(2n + 3),
    .project-grid:not(.featured) article:nth-child(2n) {
      padding-block-start: 0;
    }
    .featured article:first-child :global(img) {
      aspect-ratio: 4 / 3;
    }
  }
</style>
