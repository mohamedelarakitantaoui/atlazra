---
import { t } from '../../i18n/content';
// Inline copies of the public/brand originals, path data rounded to one
// decimal (about 0.006 px at the sizes used here; renders identical):
//   pnpm dlx svgo@3.3.2 --precision 1 -i public/brand/<file> -o src/assets/brand/<file>
// The originals are 30–66 KB each and were inlined two or three times per page.
import full from '../../assets/brand/atlazra-logo.svg?raw';
import mark from '../../assets/brand/atlazra-mark.svg?raw';
import wordmark from '../../assets/brand/atlazra-wordmark.svg?raw';

interface Props {
  variant?: 'full' | 'mark' | 'wordmark';
  label?: string;
  decorative?: boolean;
}
const {
  variant = 'wordmark',
  label = t('fr', 'footer.brand'),
  decorative = false,
} = Astro.props;
const artwork = { full, mark, wordmark }[variant];
---

<span
  class:list={['logo', `logo-${variant}`]}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : label}
  aria-hidden={decorative ? 'true' : undefined}
>
  <span aria-hidden="true" set:html={artwork} />
</span>

<style>
  /* Reference: .brand svg (57), .mark (81–82). Full lockup uses the same 58px mark height. */
  .logo {
    display: inline-flex;
    align-items: center;
    color: var(--forest);
    max-width: 100%;
  }
  .logo :global(svg) {
    display: block;
    max-width: 100%;
    width: auto;
    height: 19px;
  }
  .logo-mark :global(svg),
  .logo-full :global(svg) {
    height: 58px;
  }
</style>
