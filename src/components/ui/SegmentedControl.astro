---
interface Props {
  label: string;
  options: { value: string; label: string }[];
  value?: string;
}
const { label, options, value = options[0]?.value } = Astro.props;
const selected = options.some((option) => option.value === value)
  ? value
  : options[0]?.value;
---

<ui-segmented class="seg" role="radiogroup" aria-label={label}>
  <span class="thumb" aria-hidden="true"></span>
  {
    options.map((option) => (
      <button
        type="button"
        role="radio"
        aria-checked={option.value === selected}
        tabindex={option.value === selected ? 0 : -1}
        data-value={option.value}
      >
        {option.label}
      </button>
    ))
  }
</ui-segmented>

<script>
  class SegmentedControl extends HTMLElement {
    private observer?: ResizeObserver;
    private buttons: HTMLButtonElement[] = [];
    private moveThumb = () => {
      const active = this.buttons.find(
        (button) => button.getAttribute('aria-checked') === 'true',
      );
      const thumb = this.querySelector<HTMLElement>('.thumb');
      if (!active || !thumb) return;
      thumb.style.width = `${active.offsetWidth}px`;
      thumb.style.transform = `translateX(${active.offsetLeft - 4}px)`;
      this.dataset.ready = 'true';
    };
    private select(button: HTMLButtonElement) {
      if (button.getAttribute('aria-checked') === 'true') return;
      this.buttons.forEach((item) => {
        item.setAttribute('aria-checked', String(item === button));
        item.tabIndex = item === button ? 0 : -1;
      });
      this.moveThumb();
      this.dispatchEvent(
        new CustomEvent('change', {
          bubbles: true,
          detail: { value: button.dataset.value },
        }),
      );
    }
    connectedCallback() {
      this.buttons = Array.from(this.querySelectorAll('button'));
      if (!this.dataset.initialized) {
        this.dataset.initialized = 'true';
        this.buttons.forEach((button, index) => {
          button.addEventListener('pointerdown', (event) => {
            if (event.button === 0) this.select(button);
          });
          button.addEventListener('click', () => this.select(button));
          button.addEventListener('keydown', (event) => {
            const rtl = getComputedStyle(this).direction === 'rtl';
            let target: number;
            if (event.key === 'Home') target = 0;
            else if (event.key === 'End') target = this.buttons.length - 1;
            else if (event.key === 'ArrowRight')
              target = index + (rtl ? -1 : 1);
            else if (event.key === 'ArrowLeft') target = index + (rtl ? 1 : -1);
            else return;
            event.preventDefault();
            const next =
              this.buttons[
                (target + this.buttons.length) % this.buttons.length
              ];
            next.focus();
            this.select(next);
          });
        });
      }
      this.observer = new ResizeObserver(this.moveThumb);
      this.observer.observe(this);
      document.fonts.ready.then(this.moveThumb);
      this.moveThumb();
    }
    disconnectedCallback() {
      this.observer?.disconnect();
    }
  }
  if (!customElements.get('ui-segmented'))
    customElements.define('ui-segmented', SegmentedControl);
</script>

<style>
  /* Reference: .seg (93–97). Position belongs to the consuming layout.
     44px targets follow AGENTS.md; thumb shadow uses the approved semantic token. */
  .seg {
    position: relative;
    display: inline-flex;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: var(--glass-control);
    backdrop-filter: blur(16px) saturate(180%);
    box-shadow: var(--shadow-float);
    max-width: 100%;
  }
  .thumb {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    border-radius: var(--radius-pill);
    background: var(--paper);
    box-shadow: var(--shadow-thumb);
    visibility: hidden;
  }
  .seg[data-ready='true'] .thumb {
    visibility: visible;
    transition:
      transform var(--dur-move) var(--ease-out),
      width var(--dur-move) var(--ease-out);
  }
  button {
    position: relative;
    z-index: 1;
    border: 0;
    background: none;
    font: 600 0.86rem var(--font);
    color: var(--ink-2);
    min-height: 44px;
    min-width: 44px;
    padding: 0 16px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    white-space: nowrap;
    transition: color var(--dur) ease;
  }
  :global(html[dir='rtl']) button {
    font-family: var(--font-ar);
  }
  button[aria-checked='true'] {
    color: var(--forest);
  }
  .seg:not([data-ready='true']) button[aria-checked='true'] {
    background: var(--paper);
    box-shadow: var(--shadow-thumb);
  }
  @media (prefers-reduced-transparency: reduce) {
    .seg {
      background: var(--paper);
      backdrop-filter: none;
    }
  }
</style>
