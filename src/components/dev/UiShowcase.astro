---
import '../../styles/base.css';
import Logo from '../../components/ui/Logo.astro';
import Button from '../../components/ui/Button.astro';
import SegmentedControl from '../../components/ui/SegmentedControl.astro';
import AccordionRow from '../../components/ui/AccordionRow.astro';
import Chip from '../../components/ui/Chip.astro';
import Field from '../../components/ui/Field.astro';
import ChoiceChip from '../ui/ChoiceChip.astro';
import LanguageSwitcher from '../LanguageSwitcher.astro';
import { t } from '../../i18n/content';
import type { Locale } from '../../i18n/routing';

interface Props {
  lang?: Locale;
}
const { lang = 'fr' } = Astro.props;
---

<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="robots" content="noindex, nofollow" />
    <title>{t(lang, 'pages.ui.title')} — {t(lang, 'footer.brand')}</title>
  </head>
  <body>
    <main class="wrap showcase">
      <div class="intro">
        <p class="muted">{t(lang, 'pages.ui.intro')}</p>
        <h1>{t(lang, 'pages.ui.title')}</h1>
        <div class="languages"><LanguageSwitcher locale={lang} /></div>
      </div>

      <div class="samples">
        <section class="sample" aria-labelledby="logos">
          <h2 id="logos">{t(lang, 'pages.ui.logos')}</h2>
          <div class="logo-list">
            <figure>
              <Logo variant="full" /><figcaption>
                {t(lang, 'pages.ui.full')}
              </figcaption>
            </figure>
            <figure>
              <Logo variant="mark" /><figcaption>
                {t(lang, 'pages.ui.mark')}
              </figcaption>
            </figure>
            <figure>
              <Logo variant="wordmark" /><figcaption>
                {t(lang, 'pages.ui.wordmark')}
              </figcaption>
            </figure>
          </div>
        </section>

        <section class="sample" aria-labelledby="buttons">
          <h2 id="buttons">{t(lang, 'pages.ui.buttons')}</h2>
          <div class="inline">
            <Button>{t(lang, 'pages.ui.primary')}</Button><Button
              variant="quiet"
              href="#fields">{t(lang, 'pages.ui.quiet')}</Button
            >
          </div>
          <div class="chip-surface inline">
            <Chip>{t(lang, 'pages.ui.chip')}</Chip><Chip
              >{t(lang, 'pages.ui.selected')}</Chip
            >
          </div>
          <fieldset class="choices">
            <legend>{t(lang, 'pages.ui.controls')}</legend>
            <div class="inline">
              <ChoiceChip
                id="choice-villa"
                name="demo-type"
                value="villa"
                checked>{t(lang, 'pages.ui.chip')}</ChoiceChip
              >
              <ChoiceChip id="choice-plan" name="demo-type" value="plan"
                >{t(lang, 'pages.ui.selected')}</ChoiceChip
              >
            </div>
          </fieldset>
        </section>

        <section class="sample" aria-labelledby="controls">
          <h2 id="controls">{t(lang, 'pages.ui.controls')}</h2>
          <div class="control-surface">
            <SegmentedControl
              label={t(lang, 'pages.ui.model')}
              options={[
                { value: 'current', label: t(lang, 'pages.ui.current') },
                { value: 'project', label: t(lang, 'pages.ui.project') },
              ]}
              value="project"
            />
          </div>
          <p class="muted">{t(lang, 'pages.ui.controlsNote')}</p>
        </section>

        <section class="sample" aria-labelledby="accordion">
          <h2 id="accordion">{t(lang, 'pages.ui.accordion')}</h2>
          <div class="rows">
            <AccordionRow
              id="design"
              title={t(lang, 'pages.ui.design')}
              summary={t(lang, 'pages.ui.summary')}
              open
            >
              <p>{t(lang, 'pages.ui.detail')}</p>
              <a class="link" href="#fields">{t(lang, 'pages.ui.link')}</a>
            </AccordionRow>
            <AccordionRow id="materials" title={t(lang, 'pages.ui.more')}>
              <p>{t(lang, 'pages.ui.moreDetail')}</p>
              <a class="link" href="#fields">{t(lang, 'pages.ui.link')}</a>
            </AccordionRow>
          </div>
        </section>

        <section
          class="sample fields"
          id="fields"
          aria-labelledby="fields-title"
        >
          <h2 id="fields-title">{t(lang, 'pages.ui.fields')}</h2>
          <div class="field-grid">
            <Field
              id="demo-name"
              name="name"
              label={t(lang, 'pages.ui.name')}
              autocomplete="name"
              required
            />
            <Field
              id="demo-phone"
              name="phone"
              label={`${t(lang, 'pages.ui.phone')} · ${t(lang, 'pages.ui.errorLabel')}`}
              type="tel"
              autocomplete="tel"
              error={t(lang, 'pages.ui.error')}
              required
            />
            <div class="message">
              <Field
                id="demo-message"
                name="message"
                label={t(lang, 'pages.ui.projectLabel')}
                as="textarea"
                placeholder={t(lang, 'pages.ui.placeholder')}
              />
            </div>
          </div>
        </section>
      </div>
    </main>
  </body>
</html>

<style>
  /* Showcase-only layout uses the approved spacing scale. No production sections. */
  .showcase {
    padding-block: var(--space-12) var(--space-16);
  }
  .intro {
    display: grid;
    gap: var(--space-4);
    margin-block-end: var(--space-12);
  }
  .languages {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .samples {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-12) var(--space-12);
    align-items: start;
  }
  .sample {
    min-width: 0;
    display: grid;
    gap: var(--space-6);
    border-top: 1px solid var(--rule);
    padding-block-start: var(--space-6);
  }
  .logo-list,
  .inline {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .logo-list {
    gap: var(--space-8);
  }
  figure {
    margin: 0;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
  }
  figcaption {
    color: var(--ink-2);
    font-size: 0.85rem;
  }
  .chip-surface {
    background: var(--mist);
    padding: var(--space-4);
    border-radius: var(--radius-m);
  }
  .control-surface {
    background: var(--mist);
    border-radius: var(--radius-m);
    padding: var(--space-6);
  }
  .rows {
    border-top: 1px solid var(--rule);
  }
  .fields {
    grid-column: 1 / -1;
  }
  .field-grid {
    display: grid;
    align-items: start;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-6);
  }
  .message {
    grid-column: 1 / -1;
  }
  .choices {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .choices legend {
    font-size: 0.85rem;
    font-weight: 500;
    margin-block-end: 6px;
  }
  @media (max-width: 860px) {
    .samples {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 540px) {
    .field-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .control-surface {
      padding: var(--space-4);
    }
  }
</style>
