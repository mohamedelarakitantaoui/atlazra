---
import Logo from './ui/Logo.astro';
import { t } from '../i18n/content';
import type { Locale } from '../i18n/routing';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const brand = t(locale, 'footer.brand');
const [copyrightStart, copyrightEnd] = t(locale, 'footer.copyright')
  .replace('{year}', String(new Date().getUTCFullYear()))
  .split(brand);
---

<footer>
  <div class="wrap foot">
    <div class="signature">
      <a class="brand" href={`/${locale}/`} aria-label={t(locale, 'nav.home')}
        ><Logo decorative /></a
      >
      <small>{t(locale, 'home.title')}</small>
    </div>
    <small class="copyright"
      >{copyrightStart}<bdi>{brand}</bdi>{copyrightEnd}</small
    >
  </div>
</footer>

<style>
  /* Reference footer, lines 190–193, markup 372–376. */
  footer {
    padding-block: 48px 40px;
    border-top: 1px solid var(--rule);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 40px;
    justify-content: space-between;
    align-items: end;
  }
  .signature {
    display: grid;
    gap: 10px;
  }
  .brand {
    display: flex;
    align-items: center;
    color: var(--forest);
    text-decoration: none;
    min-height: 44px;
  }
  .foot .brand :global(svg) {
    height: 22px;
  }
  small {
    color: var(--ink-2);
    font-size: 0.85rem;
  }
</style>
