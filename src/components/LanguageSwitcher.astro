---
import { locales, localizedPath, type Locale } from '../i18n/routing';
import { t } from '../i18n/content';
interface Props {
  locale: Locale;
  path?: string;
}
const { locale, path } = Astro.props;
---

<nav
  class="lang"
  aria-label={t(locale, 'nav.language')}
  data-language-switch
  data-language-path={path}
>
  {
    locales.map((target) => (
      <a
        href={localizedPath(
          path ?? Astro.url.pathname + Astro.url.search,
          target,
        )}
        lang={target}
        hreflang={target}
        aria-current={locale === target ? 'page' : undefined}
      >
        {t(locale, `nav.locales.${target}`)}
      </a>
    ))
  }
</nav>

<script>
  import { localizedPath, type Locale } from '../i18n/routing';
  // Hashes are not sent to the server; preserve them as well as query strings.
  const update = () =>
    document
      .querySelectorAll<HTMLAnchorElement>('[data-language-switch] a[lang]')
      .forEach((link) => {
        link.href = localizedPath(
          link.closest<HTMLElement>('[data-language-switch]')?.dataset
            .languagePath ??
            location.pathname + location.search + location.hash,
          link.lang as Locale,
        );
      });
  update();
  addEventListener('hashchange', update);
</script>

<style>
  /* Reference .lang, lines 61–63; 44px hit areas follow AGENTS.md. */
  .lang {
    display: flex;
    background: var(--mist);
    border-radius: var(--radius-pill);
    padding: 3px;
    position: relative;
    flex: none;
  }
  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
    font: 600 0.78rem var(--font);
    color: var(--ink-2);
    min-width: 44px;
    min-height: 44px;
    border-radius: var(--radius-pill);
    text-decoration: none;
  }
  a[aria-current='page'] {
    color: var(--ink);
    background: var(--paper);
    box-shadow: var(--shadow-thumb);
  }
  a[lang='ar'] {
    font-family: var(--font-ar);
    font-size: 1.125rem;
    line-height: 1.3;
  }
</style>
