---
interface Props {text:string}
const {text}=Astro.props;
// Preserve width × depth order in RTL, including localized decimal numerals.
const dimension=/([\d٠-٩]+(?:[.,٫][\d٠-٩]+)?\s×\s[\d٠-٩]+(?:[.,٫][\d٠-٩]+)?)/u;
const parts=text.split(dimension);
---
{parts.map((part,index)=>index%2?<bdi>{part}</bdi>:part)}
