---
import '../styles/base.css';
import { t } from '../i18n/content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { locales, localizedPath, type Locale } from '../i18n/routing';
// Same hashed file as the 600 @font-face in fonts.css: the hero h1's weight.
import arabicHeading from '../assets/fonts/ibm-plex-sans-arabic-arabic-600.woff2?url';
import arabicBody from '../assets/fonts/ibm-plex-sans-arabic-arabic-400.woff2?url';
import arabicLatinBody from '../assets/fonts/ibm-plex-sans-arabic-latin-400.woff2?url';
import arabicLatinHeading from '../assets/fonts/ibm-plex-sans-arabic-latin-600.woff2?url';
interface Props {
  locale: Locale;
  title: string;
  description: string;
  languagePath?: string;
  projectFonts?: boolean;
}
const {
  locale,
  title,
  description,
  languagePath,
  projectFonts = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={locale} dir={locale === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <title>{title} — {t(locale, 'footer.brand')}</title>
    {
      locale === 'ar' && (
        <link
          rel="preload"
          href={arabicHeading}
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
    <link rel="canonical" href={canonical} />
    {
      locale === 'ar' &&
        projectFonts &&
        [arabicBody, arabicLatinBody, arabicLatinHeading].map((href) => (
          <link rel="preload" {href} as="font" type="font/woff2" crossorigin />
        ))
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      locales.map((lang) => (
        <link
          rel="alternate"
          hreflang={lang}
          href={new URL(localizedPath(Astro.url.pathname, lang), Astro.site)}
        />
      ))
    }
  </head>
  <body>
    <a class="skip" href="#top">{t(locale, 'nav.skip')}</a>
    <Header {locale} {languagePath} />
    <main id="top" tabindex="-1"><slot /></main>
    <Footer {locale} />
  </body>
</html>

<style>
  body {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
  }
  main:focus {
    outline: none;
  }
  /* Off-screen until keyboard focus; sits above the sticky header. */
  .skip {
    position: fixed;
    inset-block-start: calc(env(safe-area-inset-top, 0px) + 8px);
    inset-inline-start: max(20px, env(safe-area-inset-left, 0px));
    z-index: 30;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 16px;
    border-radius: var(--radius-pill);
    background: var(--forest);
    color: var(--paper);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(calc(-100% - 16px));
  }
  .skip:focus-visible {
    transform: none;
  }
</style>
