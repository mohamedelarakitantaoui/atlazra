---
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { locales, localizedPath, type Locale } from '../i18n/routing';
interface Props {
  locale: Locale;
  title: string;
  description: string;
}
const { locale, title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={locale} dir={locale === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <title>{title} — Atlazra Design</title>
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      locales.map((lang) => (
        <link
          rel="alternate"
          hreflang={lang}
          href={new URL(localizedPath(Astro.url.pathname, lang), Astro.site)}
        />
      ))
    }
  </head>
  <body>
    <Header {locale} />
    <main id="top"><slot /></main>
    <Footer {locale} />
  </body>
</html>

<style>
  body {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
  }
</style>
