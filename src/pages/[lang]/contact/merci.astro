---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Button from '../../../components/ui/Button.astro';
import { locales, type Locale } from '../../../i18n/routing';
import { t } from '../../../i18n/content';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
---

<SiteLayout
  {locale}
  title={t(locale, 'contact.form.success')}
  description={t(locale, 'contact.form.successDetail')}
>
  <section class="wrap">
    <h1>{t(locale, 'contact.form.success')}</h1><p>
      {t(locale, 'contact.form.successDetail')}
    </p><Button href={`/${locale}/`}>{t(locale, 'contact.form.back')}</Button>
  </section>
</SiteLayout>
<style>
  section {
    padding-block: 96px;
    display: grid;
    gap: 24px;
    justify-items: start;
  }
</style>
