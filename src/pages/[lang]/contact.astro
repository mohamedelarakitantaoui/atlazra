---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { locales, type Locale } from '../../i18n/routing';
import { t } from '../../i18n/content';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
---

<SiteLayout
  {locale}
  title={t(locale, 'contact.title')}
  description={t(locale, 'contact.intro')}
>
  <section class="wrap contact">
    <div class="copy">
      <h1>{t(locale, 'contact.title')}</h1><p>{t(locale, 'contact.intro')}</p>
    </div>
    <dl>
      <div>
        <dt>{t(locale, 'contact.address')}</dt><dd>
          {t(locale, 'contact.location')}<br /><a
            class="link"
            href="https://maps.app.goo.gl/6f43CHxzyrMHoT4f9"
            target="_blank"
            rel="noopener">{t(locale, 'contact.map')}</a
          >
        </dd>
      </div>
      <div>
        <dt>{t(locale, 'contact.phone')}</dt><dd
          class="muted"
          data-client-todo={t(locale, 'contact.todos.phone')}
        >
          {t(locale, 'contact.pending')}
        </dd>
      </div>
      <div>
        <dt>{t(locale, 'contact.email')}</dt><dd
          class="muted"
          data-client-todo={t(locale, 'contact.todos.email')}
        >
          {t(locale, 'contact.pending')}
        </dd>
      </div>
      <div>
        <dt>{t(locale, 'contact.hours')}</dt><dd
          class="muted"
          data-client-todo={t(locale, 'contact.todos.hours')}
        >
          {t(locale, 'contact.pending')}
        </dd>
      </div>
    </dl>
  </section>
</SiteLayout>

<style>
  /* Contact information only; reference .contact/dl typography, lines 163–167. */
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: start;
    padding-block: clamp(64px, 9vw, 120px);
  }
  .copy {
    display: grid;
    gap: 14px;
  }
  .copy p {
    font-size: 1.125rem;
    color: var(--ink-2);
  }
  dl {
    margin: 0;
    display: grid;
    gap: 18px;
  }
  dt {
    font-size: 0.82rem;
    color: var(--ink-2);
    margin-bottom: 2px;
  }
  dd {
    margin: 0;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  @media (max-width: 860px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
