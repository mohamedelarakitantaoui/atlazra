---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { locales, type Locale } from '../../i18n/routing';
import { t } from '../../i18n/content';
import ContactDetails from '../../components/ContactDetails.astro';
import ContactForm from '../../components/contact/ContactForm.astro';
import Button from '../../components/ui/Button.astro';
import { whatsappUrl } from '../../data/site';
import { createContactToken } from '../../lib/contact/security';
import { fields, type ContactErrors } from '../../lib/contact/schema';
export const prerender = false;
const locale = Astro.params.lang as Locale;
if (!locales.includes(locale)) return Astro.redirect('/404.html');
Astro.response.headers.set('Cache-Control', 'private, no-store');
const token = createContactToken(
  process.env.CONTACT_SIGNING_SECRET ??
    import.meta.env.CONTACT_SIGNING_SECRET ??
    '',
);
const errors: ContactErrors = {};
for (const field of (Astro.url.searchParams.get('errors') ?? '').split(',')) {
  const key = [...fields, 'spam', 'time', 'form'] as const;
  const known = key.find((key) => key === field);
  if (known) errors[known] = t(locale, `contact.form.errors.${known}`);
}
const failed = Astro.url.searchParams.get('failed') === '1';
const whatsapp = whatsappUrl(locale);
---

<SiteLayout
  {locale}
  title={t(locale, 'contact.title')}
  description={t(locale, 'contact.intro')}
>
  <section class="wrap contact">
    <div class="copy">
      <h1>{t(locale, 'contact.title')}</h1><p>{t(locale, 'contact.intro')}</p>
      <ContactDetails {locale} />
      {
        whatsapp && (
          <Button variant="quiet" href={whatsapp}>
            {t(locale, 'contact.form.whatsapp')}
          </Button>
        )
      }
    </div>
    <ContactForm {locale} {token} {errors} {failed} />
  </section>
</SiteLayout>

<style>
  /* Reference contact grid, lines 163–185. */
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: start;
    padding-block: clamp(64px, 9vw, 120px);
  }
  .copy {
    display: grid;
    gap: 14px;
  }
  .copy p {
    font-size: 1.125rem;
    color: var(--ink-2);
  }
  .copy :global(dl) {
    margin-block-start: 24px;
  }
  @media (max-width: 860px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
