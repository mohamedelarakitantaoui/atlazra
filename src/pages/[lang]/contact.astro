---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { locales, type Locale } from '../../i18n/routing';
import { content, clientTodos } from '../../i18n/content';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const t = content[locale];
---

<SiteLayout {locale} title={t.contactTitle} description={t.contactText}>
  <section class="wrap contact">
    <div class="copy"><h1>{t.contactTitle}</h1><p>{t.contactText}</p></div>
    <dl>
      <div>
        <dt>{t.address}</dt><dd>
          Dar Nizar, {t.region}<br /><a
            class="link"
            href="https://maps.app.goo.gl/6f43CHxzyrMHoT4f9"
            target="_blank"
            rel="noopener">{t.map}</a
          >
        </dd>
      </div>
      <div>
        <dt>{t.phone}</dt><dd
          class="muted"
          data-client-todo={clientTodos.phone}
        >
          {t.pending}
        </dd>
      </div>
      <div>
        <dt>{t.email}</dt><dd
          class="muted"
          data-client-todo={clientTodos.email}
        >
          {t.pending}
        </dd>
      </div>
      <div>
        <dt>{t.hours}</dt><dd
          class="muted"
          data-client-todo={clientTodos.hours}
        >
          {t.pending}
        </dd>
      </div>
    </dl>
  </section>
</SiteLayout>

<style>
  /* Contact information only; reference .contact/dl typography, lines 163–167. */
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: start;
    padding-block: clamp(64px, 9vw, 120px);
  }
  .copy {
    display: grid;
    gap: 14px;
  }
  .copy p {
    font-size: 1.125rem;
    color: var(--ink-2);
  }
  dl {
    margin: 0;
    display: grid;
    gap: 18px;
  }
  dt {
    font-size: 0.82rem;
    color: var(--ink-2);
    margin-bottom: 2px;
  }
  dd {
    margin: 0;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  @media (max-width: 860px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
