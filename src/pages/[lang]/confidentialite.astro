---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { locales, type Locale } from '../../i18n/routing';
import { t } from '../../i18n/content';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
---

<SiteLayout
  {locale}
  title={t(locale, 'pages.privacy.title')}
  description={t(locale, 'pages.privacy.intro')}
>
  <section class="wrap page-shell">
    <h1>{t(locale, 'pages.privacy.title')}</h1>
    <p>{t(locale, 'pages.privacy.intro')}</p>
    <p class="muted placeholder">{t(locale, 'pages.privacy.todo')}</p>
  </section>
</SiteLayout>
