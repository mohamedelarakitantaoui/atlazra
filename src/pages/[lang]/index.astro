---
import '../../styles/home.css';
import ProjectGrid from '../../components/projects/ProjectGrid.astro';
import { publishedProjects } from '../../lib/projects';
import SiteLayout from '../../layouts/SiteLayout.astro';
import GardenModel from '../../components/garden/GardenModel.astro';
import ChapterLabel from '../../components/ChapterLabel.astro';
import MeasuredText from '../../components/MeasuredText.astro';
import { site, isPending } from '../../data/site';
import { locales, type Locale } from '../../i18n/routing';
import { t, getRedesign } from '../../i18n/content';
import { businessJsonLd, jsonLdScript } from '../../lib/structured-data';
import { callouts, formatCallout, pins } from '../../components/garden/plan';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const r = getRedesign(locale);
const latestProjects = (await publishedProjects())
  .sort(
    (a, b) =>
      b.data.year - a.data.year || a.data.sort_order - b.data.sort_order,
  )
  .slice(0, 3);
---

<SiteLayout
  {locale}
  title={t(locale, 'seo.home.title')}
  description={t(locale, 'seo.home.description')}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={jsonLdScript(businessJsonLd(locale, Astro.site!))}
  />
  <section id="hero" class="hero" aria-labelledby="hero-title">
    <div class="hero-grid">
      <div class="giant" aria-hidden="true">
        <div class="word">
          <img
            src="/redesign/monogram.webp"
            alt=""
            width="160"
            height="137"
          />TLAZRA
        </div>
      </div>

      <GardenModel {locale} hero />
      <div class="left hero-copy">
        <span class="label" style="color:var(--accent-text)">{r.kicker}</span>
        <h1 id="hero-title">{r.h1}</h1>
        <p>{r.hp}</p>
        <div class="ctas">
          <a class="btn btn-gold" href={`/${locale}/contact/`}>{r.cta}</a><a
            class="btn btn-ghost"
            href="#plan">{r.cta2}</a>
        </div>
      </div>

      <div class="right">
        <ol class="idx" aria-label={r.steps}>
          <li><bdi>01</bdi><span>{r.s1}</span></li>
          <li><bdi>02</bdi><span>{r.s2}</span></li>
          <li><bdi>03</bdi><span>{r.s3}</span></li>
          <li><bdi>04</bdi><span>{r.s4}</span></li>
        </ol>
      </div>

      <p class="bc label" style="margin:0">{r.towns}</p>
      <p class="br label" style="margin:0">
        <svg
          width="22"
          height="12"
          viewBox="0 0 22 12"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path d="M5 1 1 6l4 5M17 1l4 5-4 5M1 6h20"></path></svg
        ><span>{r.drag}</span>
      </p>
    </div>
  </section>

  <!-- 01 PLAN -->
  <section class="plan" id="plan" aria-labelledby="plan-h">
    <div class="wrap">
      <div>
        <div class="chap label">
          <ChapterLabel text={r.pl} /><bdi>01 / 06</bdi>
        </div>
          <h2 class="display rv" id="plan-h"><MeasuredText text={r.ph}/></h2>
        <ol class="callouts" id="callouts">
          {
            callouts.map(({ key, values }, i) => (
              <li data-k={key}>
                <button
                  type="button"
                  aria-pressed={key === 'pool' ? 'true' : 'false'}
                >
                  <>
                    <bdi class="n">{String(i + 1).padStart(2, '0')}</bdi>
                    <span>
                      <>
                        <strong>{r[('c' + (i + 1)) as keyof typeof r]}</strong>
                        <span class="d">
                          <MeasuredText text={formatCallout(
                            r[('c' + (i + 1) + 'd') as keyof typeof r],
                            values,
                            locale,
                          )}/>
                        </span>
                      </>
                    </span>
                  </>
                </button>
              </li>
            ))
          }
        </ol>
        <p class="note">{r.pn}</p>
      </div>
      <figure class="sheet" style="margin:0">
        <img
          src="/redesign/plan-project.webp"
          alt={r.planAlt}
          width="1200"
          height="899"
          loading="lazy"
        />
        <div class="pins" id="pins" dir="ltr">
          {
            callouts.map(({ key }, i) => (
              <button
                type="button"
                class="pin"
                data-k={key}
                aria-pressed={key === 'pool' ? 'true' : 'false'}
                aria-label={`${String(i+1).padStart(2,'0')} ${r[('c' + (i + 1)) as keyof typeof r]}`}
                style={`left:${pins[key][0]}%;top:${pins[key][1]}%`}
              >
                {String(i + 1).padStart(2, '0')}
              </button>
            ))
          }
        </div>
        <figcaption class="sheet-meta label">
          <span>{r.pc}</span><bdi>{r.north}</bdi>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 02 BEFORE / AFTER -->
  <section class="ba" aria-labelledby="ba-h">
    <div class="wrap">
      <div class="ba-head">
        <div>
          <div class="chap label" style="color:var(--accent-text)">
            <ChapterLabel text={r.bl} />
          </div>
          <h2 class="display rv" id="ba-h">{r.bh}</h2>
        </div>
        <p>{r.bp}</p>
      </div>
      <div class="compare" id="compare" style="--split:50%">
        <img
          src="/redesign/plan-current.webp"
          alt={r.beforeAlt}
          width="1200"
          height="899"
          loading="lazy"
        />
        <img
          class="after"
          src="/redesign/plan-project.webp"
          alt={r.afterAlt}
          width="1200"
          height="899"
          loading="lazy"
        />
        <div class="handle" aria-hidden="true">
          <div class="knob">
            <svg
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#0A2618"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M8 7 3 12l5 5M16 7l5 5-5 5"></path></svg>
          </div>
        </div>
        <span class="tagL label">{r.t0}</span><span class="tagR label"
          >{r.t1}</span
        >
        <input
          type="range"
          min="0"
          max="100"
          value="50"
          id="split"
          aria-label={r.splitLabel}
        />
      </div>
    </div>
  </section>

  <!-- 03 SERVICES -->
  <section class="svc" id="services" aria-labelledby="svc-h">
    <div class="wrap">
      <div class="svc-head">
        <div class="chap label">
          <ChapterLabel text={r.sl} /><bdi>03 / 06</bdi>
        </div>
        <h2 class="display rv" id="svc-h">{r.sh}</h2>
      </div>
      <ul class="rows">
        <li>
          <bdi class="n">[01]</bdi><h3>{r.v1}</h3><p>{r.v1p}</p><img
            src="/redesign/plan-project.webp"
            alt=""
            width="1200"
            height="899"
            loading="lazy"
          />
        </li>
        <li>
          <bdi class="n">[02]</bdi><h3>{r.v2}</h3><p>{r.v2p}</p><img
            src="/redesign/a-pool.webp"
            alt=""
            width="900"
            height="900"
            loading="lazy"
          />
        </li>
        <li>
          <bdi class="n">[03]</bdi><h3>{r.v3}</h3><p>{r.v3p}</p><img
            src="/redesign/a-pergola.webp"
            alt=""
            width="900"
            height="900"
            loading="lazy"
          />
        </li>
      </ul>
      <span class="todo" data-client-todo={r.servicesTodo}>{r.pending}</span>
    </div>
  </section>

  <!-- 04 PALETTE -->
  <section class="pal" id="palette" aria-labelledby="pal-h">
    <div class="wrap">
      <div class="pal-head">
        <div>
          <div class="chap label" style="color:var(--accent-text)">
            <ChapterLabel text={r.vl} /><bdi>04 / 06</bdi>
          </div>
          <h2 class="display rv" id="pal-h">{r.vh}</h2>
        </div>
        <p>{r.vp}</p>
      </div>
      <div class="twine">
        <div class="pal-word" aria-hidden="true">{r.pw}</div>
        <svg
          class="cord"
          viewBox="0 0 1000 60"
          preserveAspectRatio="none"
          aria-hidden="true"
          ><path
            d="M0 8 Q 500 46 1000 8"
            fill="none"
            stroke="rgba(201,162,107,.6)"
            stroke-width="1.5"></path></svg
        >
        <ul class="tags">
          <li class="tag" style="--r:-3deg;--drop:30px">
            <div class="card">
              <span class="label" style="color:var(--accent-text)">01</span><h3>
                {r.p1}
              </h3><p class="lat" dir="ltr">{r.latin1}</p><dl>
                <dt>{r.water}</dt><dd>{r.low}</dd><dt>{r.use}</dt><dd>
                  {r.p1u}
                </dd>
              </dl>
            </div>
          </li>
          <li class="tag" style="--r:2deg;--drop:44px">
            <div class="card">
              <span class="label" style="color:var(--accent-text)">02</span><h3>
                {r.p2}
              </h3><p class="lat" dir="ltr">{r.latin2}</p><dl>
                <dt>{r.water}</dt><dd>{r.low}</dd><dt>{r.use}</dt><dd>
                  {r.p2u}
                </dd>
              </dl>
            </div>
          </li>
          <li class="tag" style="--r:-1.5deg;--drop:54px">
            <div class="card">
              <span class="label" style="color:var(--accent-text)">03</span><h3>
                {r.p3}
              </h3><p class="lat" dir="ltr">{r.latin3}</p><dl>
                <dt>{r.water}</dt><dd>{r.mid}</dd><dt>{r.use}</dt><dd>
                  {r.p3u}
                </dd>
              </dl>
            </div>
          </li>
          <li class="tag" style="--r:2.5deg;--drop:54px">
            <div class="card">
              <span class="label" style="color:var(--accent-text)">04</span><h3>
                {r.p4}
              </h3><p class="lat" dir="ltr">{r.latin4}</p><dl>
                <dt>{r.water}</dt><dd>{r.low}</dd><dt>{r.use}</dt><dd>
                  {r.p4u}
                </dd>
              </dl>
            </div>
          </li>
          <li class="tag" style="--r:-2deg;--drop:44px">
            <div class="card">
              <span class="label" style="color:var(--accent-text)">05</span><h3>
                {r.p5}
              </h3><p class="lat" dir="ltr">{r.latin5}</p><dl>
                <dt>{r.water}</dt><dd>{r.reg}</dd><dt>{r.use}</dt><dd>
                  {r.p5u}
                </dd>
              </dl>
            </div>
          </li>
          <li class="tag" style="--r:3deg;--drop:30px">
            <div class="card">
              <span class="label" style="color:var(--accent-text)">06</span><h3>
                {r.p6}
              </h3><p class="lat" dir="ltr">{r.latin6}</p><dl>
                <dt>{r.water}</dt><dd>{r.mid}</dd><dt>{r.use}</dt><dd>
                  {r.p6u}
                </dd>
              </dl>
            </div>
          </li>
        </ul>
      </div>
      <span class="todo" style="margin-top:48px" data-client-todo={r.plantsTodo}
        >{r.pending}</span
      >
    </div>
  </section>

  <!-- 05 METHOD -->
  <section class="meth" id="etapes" aria-labelledby="meth-h">
    <div class="wrap">
      <div class="chap label">
        <ChapterLabel text={r.ml} /><bdi>05 / 06</bdi>
      </div>
      <h2 class="display rv" id="meth-h">{r.mh}</h2>
      <ol class="pages">
        <li class="page">
          <bdi class="num">01</bdi><h3>{r.m1}</h3><p>{r.m1p}</p><img
            src="/redesign/garden-current-crop.webp"
            alt=""
            width="1200"
            height="775"
            loading="lazy"
          />
        </li>
        <li class="page">
          <bdi class="num">02</bdi><h3>{r.m2}</h3><p>{r.m2p}</p><img
            src="/redesign/plan-project.webp"
            alt=""
            width="1200"
            height="899"
            loading="lazy"
          />
        </li>
        <li class="page">
          <bdi class="num">03</bdi><h3>{r.m3}</h3><p>{r.m3p}</p><img
            src="/redesign/garden-project-crop.webp"
            alt=""
            width="1200"
            height="817"
            loading="lazy"
          />
        </li>
        <li class="page">
          <bdi class="num">04</bdi><h3>{r.m4}</h3><p>{r.m4p}</p><img
            src="/redesign/a-low.webp"
            alt=""
            width="1600"
            height="830"
            loading="lazy"
          />
        </li>
      </ol>
    </div>
  </section>

  <!-- 06 PROJECTS -->
  {
    latestProjects.length ? (
      <section id="projets" class="published-projects wrap">
        <>
          <div class="chap label">
            <ChapterLabel text={r.rl} />
          </div>
          <h2 class="display">{r.publishedTitle}</h2>
          <ProjectGrid projects={latestProjects} {locale} headingLevel={3} />
        </>
      </section>
    ) : (
      <section id="projets" class="proj" aria-labelledby="proj-h">
        <div class="wrap">
          <div>
            <div class="chap label" style="color:var(--accent-text)">
              <>
                <ChapterLabel text={r.rl} />
                <bdi>06 / 06</bdi>
              </>
            </div>
            <h2 class="display rv" id="proj-h">
              {r.rh}
            </h2>
            <span class="todo pending" data-client-todo={r.photosTodo}>
              {r.pending}
            </span>
          </div>
          <ul class="types">
            <li>
              <>
                <strong>{r.r1}</strong>
                <span>{r.r1v}</span>
              </>
            </li>
            <li>
              <>
                <strong>{r.r2}</strong>
                <span>{r.r2v}</span>
              </>
            </li>
            <li>
              <>
                <strong>{r.r3}</strong>
                <span>{r.r3v}</span>
              </>
            </li>
            <li>
              <>
                <strong>{r.r4}</strong>
                <span>{r.r4v}</span>
              </>
            </li>
          </ul>
        </div>
      </section>
    )
  }

  <!-- 07 FAQ -->
  <section class="faq" aria-labelledby="faq-h">
    <div class="wrap">
      <div>
        <div class="chap label"><span>{r.ql}</span></div>
        <h2 class="display rv" id="faq-h">{r.qh}</h2>
      </div>
      <div>
        <details>
          <summary
            ><span>{r.q1}</span><span class="pm" aria-hidden="true">+</span
            ></summary
          ><p>{r.a1}</p>
        </details>
        <details>
          <summary
            ><span>{r.q2}</span><span class="pm" aria-hidden="true">+</span
            ></summary
          ><p>{r.a2}</p>
        </details>
        <details>
          <summary
            ><span>{r.q3}</span><span class="pm" aria-hidden="true">+</span
            ></summary
          ><p>{r.a3}</p>
        </details>
        <details>
          <summary
            ><span>{r.q4}</span><span class="pm" aria-hidden="true">+</span
            ></summary
          ><p data-client-todo={r.costTodo}>{r.pending}</p>
        </details>
      </div>
    </div>
  </section>

  <!-- 08 CONTACT -->
  <section class="cta" id="contact" aria-labelledby="cta-h">
    <div class="wrap">
      <div>
        <div class="chap label" style="color:var(--accent-ink)">
          <span>{r.kl}</span>
        </div>
        <h2 class="display" id="cta-h">{r.kh}</h2>
      </div>
      <div style="display:flex;flex-direction:column;gap:24px">
        <p style="margin:0">{r.kp}</p>
        <dl>
          <dt>{r.ka}</dt><dd>
            <span>{r.addr}</span><br /><a class="link" href={site.mapUrl}
              >{r.map}</a>
          </dd>
          <dt>{r.kt}</dt><dd class="pend todo" data-client-todo={site.phone}>
            {isPending(site.phone) ? r.pending : site.phone}
          </dd><dt>{r.email}</dt><dd
            class="pend todo"
            data-client-todo={site.email}
          >
            {isPending(site.email) ? r.pending : site.email}
          </dd>
        </dl>
        <a
          class="btn btn-ink"
          style="align-self:flex-start"
          href={`/${locale}/contact/`}>{r.cta}</a
        >
      </div>
    </div>
  </section>
</SiteLayout>
<script>
  import '../../components/home';
</script>
