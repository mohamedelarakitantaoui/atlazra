---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Button from '../../components/ui/Button.astro';
import { locales, type Locale } from '../../i18n/routing';
import { t, getRedesign } from '../../i18n/content';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const r = getRedesign(locale);
const services = [
  { key: 'v1', image: 'plan-project.webp', width: 1200, height: 899 },
  { key: 'v2', image: 'a-pool.webp', width: 900, height: 900 },
  { key: 'v3', image: 'a-pergola.webp', width: 900, height: 900 },
] as const;
---

<SiteLayout
  {locale}
  title={t(locale, 'seo.services.title')}
  description={t(locale, 'seo.services.description')}
>
  <section class="wrap page-shell">
    <h1>{t(locale, 'pages.services.title')}</h1>
    <p>{t(locale, 'pages.services.intro')}</p>
  </section>
  <div class="services-band">
    <ul class="wrap services" data-client-todo={r.servicesTodo}>
      {
        services.map(({ key, image, width, height }, index) => (
          <li>
            <>
              <bdi class="number">[{String(index + 1).padStart(2, '0')}]</bdi>
              <h2>{r[key]}</h2>
              <p>{r[(key + 'p') as keyof typeof r]}</p>
              <img
                src={`/redesign/${image}`}
                alt=""
                {width}
                {height}
                loading="lazy"
              />
            </>
          </li>
        ))
      }
    </ul><p class="wrap service-pending" data-client-todo={r.servicesTodo}>
      {r.pending}
    </p>
  </div>
  <section class="wrap next" aria-labelledby="next-title">
    <h2 id="next-title">{t(locale, 'home.reference.ch')}</h2>
    <p>{t(locale, 'home.reference.cp')}</p>
    <Button href={`/${locale}/contact/`}
      >{t(locale, 'home.reference.cta')}</Button
    >
  </section>
</SiteLayout>

<style>
  .page-shell {
    padding-block-end: 64px;
  }
  .services-band {
    background: var(--bone-100);
    padding-block: 32px 64px;
  }
  .services {
    list-style: none;
    margin-block: 0;
  }
  .services > li {
    display: grid;
    grid-template-columns: 52px minmax(0, 4fr) minmax(0, 5fr) 180px;
    align-items: center;
    gap: 24px;
    padding-block: 32px;
    border-top: 1px solid var(--rule);
  }
  .services > li:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .number {
    font: 500 13px var(--mono);
    color: var(--accent-text);
  }
  .services h2 {
    font-size: clamp(34px, 3.6vw, 54px);
  }
  .services p {
    color: var(--ink-2);
  }
  .services img {
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: 14px;
    width: 180px;
  }
  .service-pending {
    padding-top: 24px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .next {
    display: grid;
    justify-items: start;
    gap: 24px;
    padding-block: clamp(64px, 9vw, 120px);
  }
  .next p {
    max-width: 52ch;
    color: var(--ink-2);
  }
  @media (max-width: 1024px) {
    .services > li {
      grid-template-columns: 44px 1fr 160px;
    }
    .services p {
      grid-column: 2;
    }
    .services img {
      grid-column: 3;
      grid-row: 1/3;
    }
  }
  @media (max-width: 700px) {
    .services > li {
      grid-template-columns: 32px minmax(0, 1fr);
    }
    .services p,
    .services img {
      grid-column: 2;
      grid-row: auto;
    }
    .services img {
      width: 100%;
      max-width: 320px;
    }
  }
</style>
