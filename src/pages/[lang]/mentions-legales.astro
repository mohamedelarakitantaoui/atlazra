---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { locales, type Locale } from '../../i18n/routing';
import { t } from '../../i18n/content';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
---

<SiteLayout
  {locale}
  title={t(locale, 'seo.legal.title')}
  description={t(locale, 'seo.legal.description')}
>
  <section class="wrap page-shell">
    <h1>{t(locale, 'pages.legal.title')}</h1>
    <p>{t(locale, 'pages.legal.intro')}</p>
    <p
      class="muted placeholder"
      data-client-todo={t(locale, 'pages.legal.todo')}
    >
      {t(locale, 'contact.pending')}
    </p>
  </section>
</SiteLayout>
