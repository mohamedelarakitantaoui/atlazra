---
import SiteLayout from '../layouts/SiteLayout.astro';
import Logo from '../components/ui/Logo.astro';
import { locales } from '../i18n/routing';
import { t } from '../i18n/content';
---

<SiteLayout
  locale="fr"
  languagePath="/"
  title={t('fr', 'seo.notFound.title')}
  description={t('fr', 'seo.notFound.description')}
  canonical={false}
>
  <section class="wrap page-shell">
    <Logo variant="mark" decorative />
    <h1>{t('fr', 'pages.notFound.title')}</h1>
    <p>{t('fr', 'pages.notFound.intro')}</p>
    <div class="home-links">
      {
        locales.map((lang) => (
          <a class="link" href={`/${lang}/`} lang={lang} hreflang={lang}>
            {t(lang, 'nav.home')}
          </a>
        ))
      }
    </div>
  </section>
</SiteLayout>

<style>
  /* One language per line: mixed scripts wrap unpredictably in a row. */
  .home-links {
    display: grid;
    justify-items: start;
  }
  .home-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
